# Copy this file to ".env" and fill in your own values. Never commit ".env".

# MySQL / MariaDB connection:  mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Local (MySQL Workbench):     mysql://root:yourpassword@localhost:3306/bazaar_panun
# Hostinger: hPanel -> Databases -> MySQL Databases gives you the database name, user and host.
# If the password has special characters (@ : / # ?), URL-encode them, e.g. @ becomes %40.
DATABASE_URL="mysql://root:yourpassword@localhost:3306/bazaar_panun"

# Password for the /admin dashboard. Pick a long one.
ADMIN_PASSWORD="change-me"

# Random secret used to sign admin login cookies (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET="replace-with-a-long-random-string"
